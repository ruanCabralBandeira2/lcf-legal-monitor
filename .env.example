# Somente valores fictícios de desenvolvimento. Não copie credenciais reais para este arquivo.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql://legal_monitor:legal_monitor_dev@127.0.0.1:5432/legal_monitor
STORAGE_DIR=./storage/documents
TEMP_DIR=./storage/tmp
MAX_DOCUMENT_BYTES=52428800
DJEN_BASE_URL_PROD=https://comunicaapi.pje.jus.br/api/v1

# Integrações reais permanecem desativadas até aprovação no M0.
M0_APPROVED=false
REAL_CONNECTORS_ENABLED=false
WHATSAPP_ENABLED=false
SUMMARY_ENABLED=false

# Prova técnica opcional. Veja docs/runbooks/DEMO_NOTIFICATION.md.
# O webhook fica no Keychain do macOS, nunca no .env, Git, chat ou log.
DISCORD_DEMO_ENABLED=false
DISCORD_WEBHOOK_KEYCHAIN_SERVICE=com.lcf.legal-monitor.discord.webhook
DISCORD_WEBHOOK_KEYCHAIN_ACCOUNT=local-monitor

# E-mail (ADR-007). A senha de app do SMTP fica no cofre do sistema:
#   legal-monitor secret-set smtp
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
EMAIL_FROM=
# Listas separadas por vírgula. Operador recebe avisos de login/2FA; advogado recebe peças.
EMAIL_OPERATOR_TO=
EMAIL_LAWYER_TO=
EMAIL_MAX_ATTACHMENT_BYTES=20971520

# Navegador para login por token USB. "chrome" usa o Google Chrome instalado.
# A sessão salva fica em BROWSER_PROFILE_DIR (fora do Git, permissão restrita).
BROWSER_CHANNEL=chrome
BROWSER_HEADLESS=true
BROWSER_PROFILE_DIR=./browser_profiles

# Scheduler local. Ajustar somente após medir a carga do piloto.
SCHEDULER_LEASE_SECONDS=300
SCHEDULER_BATCH_SIZE=10
SCHEDULER_MAX_ATTEMPTS=4
SCHEDULER_BASE_BACKOFF_SECONDS=60
SCHEDULER_MAX_BACKOFF_SECONDS=3600
WORKER_STALE_SECONDS=600

# Fontes que recusam navegador sem janela (ex.: PJe TJRJ, HTTP 403) usam janela visível
# do navegador comum quando true. Nunca usar técnicas de evasão.
BROWSER_VISIBLE_FOR_BLOCKED=false
